<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishAot>false</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Copyright>CrimsonNinja</Copyright>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
        <Features>runtime-async=on</Features>
	</PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <TargetFrameworks>$(TargetFrameworks);net11.0-macos</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-macos'">
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
        <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
        <ApplicationId>com.crimsonninja.wordlens</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
        <OutputType>WinExe</OutputType>
    </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
        <PublishAot>true</PublishAot>
        <StackTraceSupport>false</StackTraceSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetricsSupport>false</MetricsSupport>
		<Http3Support>false</Http3Support>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

    <PropertyGroup>
        <UseStaticNativeHelper Condition="'$(UseStaticNativeHelper)' == ''">false</UseStaticNativeHelper>
        <StaticNativeHelperEnabled Condition="'$(UseStaticNativeHelper)' == 'true' and '$(PublishAot)' == 'true'">true</StaticNativeHelperEnabled>
        <StaticNativeHelperEnabled Condition="'$(StaticNativeHelperEnabled)' == ''">false</StaticNativeHelperEnabled>

        <RustProjectDir>$(MSBuildProjectDirectory)/../native/</RustProjectDir>
        <RustBuildProfile Condition="'$(Configuration)' == 'Release'">release</RustBuildProfile>
        <RustBuildProfile Condition="'$(Configuration)' != 'Release'">debug</RustBuildProfile>

        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'win-x64'">x86_64-pc-windows-msvc</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'linux-x64'">x86_64-unknown-linux-gnu</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">aarch64-unknown-linux-gnu</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">x86_64-unknown-linux-musl</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm64'">aarch64-unknown-linux-musl</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64-apple-darwin</RustTargetTriple>
        <RustTargetTriple Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">aarch64-apple-darwin</RustTargetTriple>

        <RustTargetPlatform Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">Windows</RustTargetPlatform>
        <RustTargetPlatform Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">Linux</RustTargetPlatform>
        <RustTargetPlatform Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('osx'))">OSX</RustTargetPlatform>
        <RustTargetPlatform Condition="'$(RustTargetPlatform)' == '' and '$(OS)' == 'Windows_NT'">Windows</RustTargetPlatform>
        <RustTargetPlatform Condition="'$(RustTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</RustTargetPlatform>
        <RustTargetPlatform Condition="'$(RustTargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">OSX</RustTargetPlatform>

        <RustLibPrefix Condition="'$(RustTargetPlatform)' != 'Windows'">lib</RustLibPrefix>
        <RustLibExt Condition="'$(RustTargetPlatform)' == 'Windows'">.dll</RustLibExt>
        <RustLibExt Condition="'$(RustTargetPlatform)' == 'Linux'">.so</RustLibExt>
        <RustLibExt Condition="'$(RustTargetPlatform)' == 'OSX'">.dylib</RustLibExt>
        <RustLibName>$(RustLibPrefix)native$(RustLibExt)</RustLibName>

        <RustStaticLibPrefix Condition="'$(RustTargetPlatform)' != 'Windows'">lib</RustStaticLibPrefix>
        <RustStaticLibExt Condition="'$(RustTargetPlatform)' == 'Windows'">.lib</RustStaticLibExt>
        <RustStaticLibExt Condition="'$(RustTargetPlatform)' != 'Windows'">.a</RustStaticLibExt>
        <RustStaticLibName>$(RustStaticLibPrefix)native$(RustStaticLibExt)</RustStaticLibName>

        <RustCargoReleaseArg Condition="'$(Configuration)' == 'Release'">--release</RustCargoReleaseArg>
        <RustCargoTargetArg Condition="'$(RustTargetTriple)' != ''">--target $(RustTargetTriple)</RustCargoTargetArg>
        <RustBuildCommand>cargo build $(RustCargoReleaseArg) $(RustCargoTargetArg)</RustBuildCommand>
        <RustOutDir Condition="'$(RustTargetTriple)' != ''">$(RustProjectDir)target/$(RustTargetTriple)/$(RustBuildProfile)/</RustOutDir>
        <RustOutDir Condition="'$(RustTargetTriple)' == ''">$(RustProjectDir)target/$(RustBuildProfile)/</RustOutDir>
        <RustStaticLibPath>$(RustOutDir)$(RustStaticLibName)</RustStaticLibPath>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup Condition="'$(StaticNativeHelperEnabled)' == 'true'">
        <DirectPInvoke Include="native" />
        <NativeLibrary Include="$(RustStaticLibPath)" />
    </ItemGroup>

    <ItemGroup Condition="'$(StaticNativeHelperEnabled)' == 'true' and '$(RustTargetPlatform)' == 'Windows'">
        <LinkerArg Include="userenv.lib" />
        <LinkerArg Include="pathcch.lib" />
        <LinkerArg Include="shell32.lib" />
        <LinkerArg Include="propsys.lib" />
    </ItemGroup>

    <ItemGroup Condition="'$(StaticNativeHelperEnabled)' == 'true' and '$(RustTargetPlatform)' == 'Linux'">
        <LinkerArg Include="-lEGL" />
        <LinkerArg Include="-lgbm" />
        <LinkerArg Include="-lwayland-client" />
        <LinkerArg Include="-lwayland-server" />
        <LinkerArg Include="-lpipewire-0.3" />
        <LinkerArg Include="-lxcb" />
        <LinkerArg Include="-lgcc_s" />
        <LinkerArg Include="-lutil" />
    </ItemGroup>


    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="Dapper.AOT" Version="1.0.52" />
        <PackageReference Include="Irihi.Ursa" Version="2.1.0" />
        <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.1.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.5.26302.115" />
        <PackageReference Include="Semi.Avalonia" Version="12.1.0" />
        <PackageReference Include="SharpHook" Version="7.1.3" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="Sortable.Avalonia" Version="2.2.0" />
        <PackageReference Include="SoundFlow" Version="1.4.1" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WordLens.Abstractions\WordLens.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
        <ProjectReference Include="..\WordLens.Windows\WordLens.Windows.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <ProjectReference Include="..\WordLens.Linux\WordLens.Linux.csproj" />
        <ProjectReference Include="..\WordLens.Macos\WordLens.Macos.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-macos'">
        <ProjectReference Include="..\WordLens.Macos\WordLens.Macos.csproj" />
    </ItemGroup>

    <Target Name="RemoveUnusedAspNetCoreHostingAssets" BeforeTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                                   Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' ==
  'aspnetcorev2_inprocess.dll'" />
        </ItemGroup>
    </Target>

    <Target Name="BuildRust" BeforeTargets="Build" Condition="'$(TargetFramework)' != ''">
        <!-- 打印一条消息，方便在构建日志中看到这个过程 -->
        <Message Text="--- 开始编译 Rust 原生库: $(RustBuildCommand) ---" Importance="high" />

        <!-- 1. 执行 cargo build 命令 -->
        <Exec Command="$(RustBuildCommand)" WorkingDirectory="$(RustProjectDir)" />

        <Error Condition="'$(StaticNativeHelperEnabled)' == 'true' and !Exists('$(RustStaticLibPath)')"
               Text="已启用 UseStaticNativeHelper，但没有找到 Rust 静态库: $(RustStaticLibPath)" />

        <!-- 2. 复制文件到输出目录 (为了 dotnet build 和本地调试) -->
        <Copy SourceFiles="$(RustOutDir)$(RustLibName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />

        <!-- 3. 动态 helper 发布时复制；静态 helper 发布时由 NativeAOT 链接进主程序。 -->
        <Copy SourceFiles="$(RustOutDir)$(RustLibName)"
              DestinationFolder="$(PublishDir)"
              SkipUnchangedFiles="true"
              Condition="'$(PublishDir)' != '' and '$(StaticNativeHelperEnabled)' != 'true'" />

        <Message Text="--- Rust 原生库编译并复制完成 ---" Importance="high" />
    </Target>
</Project>
