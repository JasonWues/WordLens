<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net11.0;net11.0-windows10.0.19041.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishAot>false</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Copyright>CrimsonNinja</Copyright>
        <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
        <Features>runtime-async=on</Features>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
        <PublishAot>true</PublishAot>
        <StackTraceSupport>false</StackTraceSupport>
		<DebuggerSupport>false</DebuggerSupport>
		<EventSourceSupport>false</EventSourceSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<MetricsSupport>false</MetricsSupport>
		<Http3Support>false</Http3Support>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="Dapper.AOT" Version="1.0.52" />
        <PackageReference Include="Irihi.Ursa" Version="2.0.0" />
        <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.0.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-preview.4.26230.115" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.4.26230.115" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.4.26230.115" />
        <PackageReference Include="Semi.Avalonia" Version="12.0.3" />
        <PackageReference Include="SharpHook" Version="7.1.2" />
        <PackageReference Include="SkiaSharp" Version="3.119.4-preview.1.1" />
        <PackageReference Include="Sortable.Avalonia" Version="2.2.0" />
        <PackageReference Include="SoundFlow" Version="1.4.1" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WordLens.Abstractions\WordLens.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-windows10.0.19041.0'">
        <ProjectReference Include="..\WordLens.Windows\WordLens.Windows.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <ProjectReference Include="..\WordLens.Linux\WordLens.Linux.csproj" />
        <ProjectReference Include="..\WordLens.Macos\WordLens.Macos.csproj" />
    </ItemGroup>

    <Target Name="BuildRust" BeforeTargets="Build" Condition="'$(TargetFramework)' != ''">
        <!-- 打印一条消息，方便在构建日志中看到这个过程 -->
        <Message Text="--- 开始编译 Rust 原生库 ---" Importance="high" />

        <!-- 1. 定义 Rust 项目相关的变量 -->
        <PropertyGroup>
            <RustProjectDir>$(MSBuildProjectDirectory)\..\native\</RustProjectDir>

            <!-- 跨平台库文件名定义 -->
            <RustLibPrefix Condition="'$(OS)' != 'Windows_NT'">lib</RustLibPrefix>

            <RustLibExt Condition="'$(OS)' == 'Windows_NT'">.dll</RustLibExt>
            <RustLibExt Condition="$([MSBuild]::IsOSPlatform('Linux'))">.so</RustLibExt>
            <RustLibExt Condition="$([MSBuild]::IsOSPlatform('OSX'))">.dylib</RustLibExt>

            <RustLibName>$(RustLibPrefix)native$(RustLibExt)</RustLibName>
        </PropertyGroup>

        <!-- 2. 根据 C# 的构建配置 (Debug/Release) 来决定 Rust 的构建参数 -->
        <PropertyGroup Condition="'$(Configuration)' == 'Release'">
            <RustBuildCommand>cargo build --release</RustBuildCommand>
            <RustOutDir>$(RustProjectDir)target/release/</RustOutDir>
        </PropertyGroup>

        <PropertyGroup Condition="'$(Configuration)' != 'Release'">
            <RustBuildCommand>cargo build</RustBuildCommand>
            <RustOutDir>$(RustProjectDir)target/debug/</RustOutDir>
        </PropertyGroup>

        <!-- 3. 执行 cargo build 命令 -->
        <Exec Command="$(RustBuildCommand)" WorkingDirectory="$(RustProjectDir)" />

        <!-- 4. 复制文件到输出目录 (为了 dotnet build 和本地调试) -->
        <Copy SourceFiles="$(RustOutDir)$(RustLibName)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />

        <!-- 5. 如果正在执行 publish，则额外复制到发布目录 -->
        <Copy SourceFiles="$(RustOutDir)$(RustLibName)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />

        <Message Text="--- Rust 原生库编译并复制完成 ---" Importance="high" />
    </Target>
</Project>
