<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:WordLens.Models"
             xmlns:sortable="clr-namespace:Sortable.Avalonia;assembly=Sortable.Avalonia"
             xmlns:vm="using:WordLens.ViewModels"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="540"
             x:Class="WordLens.Views.Settings.TtsSettingsView"
             x:DataType="vm:TtsSettingsViewModel">

    <Grid ColumnDefinitions="2*,3*">
        <ListBox Grid.Column="0"
                 Classes="settings-provider-list"
                 ItemsSource="{Binding TtsProviders}"
                 SelectedItem="{Binding SelectedTtsProvider}"
                 sortable:Sortable.Sortable="True"
                 sortable:Sortable.Mode="Sort"
                 sortable:Sortable.UpdateCommand="{Binding ReorderTtsProviderCommand}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TtsProviderConfig">
                        <Border sortable:Sortable.IsSortable="True"
                                Classes="settings-provider-card">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <PathIcon Grid.Column="0"
                                          Width="14"
                                          Height="14"
                                          Margin="0,0,8,0"
                                          Foreground="#777777"
                                          Cursor="Hand"
                                          sortable:Sortable.IsDragHandle="True"
                                          VerticalAlignment="Center"
                                          Data="M8 4.75A1.25 1.25 0 1 1 5.5 4.75A1.25 1.25 0 0 1 8 4.75ZM8 10A1.25 1.25 0 1 1 5.5 10A1.25 1.25 0 0 1 8 10ZM8 15.25A1.25 1.25 0 1 1 5.5 15.25A1.25 1.25 0 0 1 8 15.25ZM14.5 4.75A1.25 1.25 0 1 1 12 4.75A1.25 1.25 0 0 1 14.5 4.75ZM14.5 10A1.25 1.25 0 1 1 12 10A1.25 1.25 0 0 1 14.5 10ZM14.5 15.25A1.25 1.25 0 1 1 12 15.25A1.25 1.25 0 0 1 14.5 15.25Z" />

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          ToolTip.Tip="启用/禁用此 TTS 源" />

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding TypeDisplayName}" FontSize="11" Opacity="0.7" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.6" />
                                        <TextBlock Text="✓ 已启用"
                                                   FontSize="11"
                                                   Foreground="#4CAF50"
                                                   IsVisible="{Binding IsEnabled}" />
                                        <TextBlock Text="✗ 已禁用"
                                                   FontSize="11"
                                                   Foreground="#9E9E9E"
                                                   IsVisible="{Binding !IsEnabled}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1"
                BorderBrush="#DDE3E6"
                BorderThickness="1,0,0,0"
                Padding="20,0,0,0">
        <Grid
              RowDefinitions="Auto,Auto,*"
              MinHeight="0">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button Classes="settings-primary"
                        Content="添加 TTS 源"
                        Command="{Binding AddTtsProviderCommand}"
                        Padding="14,7" />
                <Button Classes="settings-danger"
                        Content="删除"
                        Command="{Binding DeleteTtsProviderCommand}"
                        IsEnabled="{Binding SelectedTtsProvider, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Padding="14,7" />
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,10" />

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8"
                            IsVisible="{Binding SelectedTtsProvider, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="TTS 源详情" FontWeight="Bold" />

                    <CheckBox Content="启用此 TTS 源"
                              IsChecked="{Binding SelectedTtsProvider.IsEnabled}"
                              FontWeight="SemiBold"
                              Margin="0,4" />

                    <Separator />

                    <TextBlock Text="名称" />
                    <TextBox Text="{Binding SelectedTtsProvider.Name}" PlaceholderText="TTS 源名称" />

                    <TextBlock Text="类型" />
                    <ComboBox ItemsSource="{Binding AvailableTtsProviderTypes}"
                              SelectedValue="{Binding SelectedTtsProvider.Type}"
                              SelectedValueBinding="{Binding Value}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" />

                    <StackPanel Spacing="8" IsVisible="{Binding IsSelectedTtsProviderLlm}">
                        <TextBlock Text="Base URL" />
                        <TextBox Text="{Binding SelectedTtsProvider.BaseUrl}" PlaceholderText="https://api.openai.com" />

                        <TextBlock Text="API Key" />
                        <TextBox Text="{Binding SelectedTtsProvider.ApiKey}"
                                 PlaceholderText="输入 TTS API Key"
                                 PasswordChar="●" />

                        <TextBlock Text="Model" />
                        <TextBox Text="{Binding SelectedTtsProvider.Model}" PlaceholderText="gpt-4o-mini-tts" />
                    </StackPanel>

                    <TextBlock Text="Voice" />
                    <TextBox Text="{Binding SelectedTtsProvider.Voice}" PlaceholderText="alloy" />

                    <TextBlock Text="语速" />
                    <NumericUpDown Value="{Binding SelectedTtsProvider.Speed}"
                                   Minimum="0.25"
                                   Maximum="4"
                                   Increment="0.1"
                                   FormatString="F1" />

                    <StackPanel Spacing="8" IsVisible="{Binding IsSelectedTtsProviderLlm}">
                        <TextBlock Text="Request Arguments" />
                        <TextBox Text="{Binding SelectedTtsProvider.RequestArguments}"
                                 PlaceholderText="{}{&quot;instructions&quot;:&quot;Speak clearly.&quot;}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>
    </Grid>
</UserControl>
