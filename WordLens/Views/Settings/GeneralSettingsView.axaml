<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:WordLens.Converter"
             xmlns:vm="using:WordLens.ViewModels"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
             x:Class="WordLens.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="20">
            <StackPanel Spacing="8">
                <TextBlock Text="界面语言" FontWeight="Bold" FontSize="14" />
                <ComboBox ItemsSource="{Binding AvailableUILanguages}"
                          SelectedValue="{Binding UiLanguage}"
                          SelectedValueBinding="{Binding Code}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          Width="300"
                          HorizontalAlignment="Left" />
                <TextBlock Text="选择应用界面显示语言（翻译语言请在翻译窗口中选择）"
                           FontSize="12"
                           Opacity="0.6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="界面字体" FontWeight="Bold" FontSize="14" />
                <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                          SelectedValue="{Binding FontFamily}"
                          SelectedValueBinding="{Binding Family}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          Width="300"
                          HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding FontFamily}"
                             PlaceholderText="输入字体名称"
                             Width="300"
                             VerticalContentAlignment="Center" />
                    <Button Content="重置"
                            Command="{Binding ResetFontFamilyCommand}" />
                </StackPanel>
                <TextBlock Text="可选择系统字体，也可输入已安装字体名称；留空使用默认字体"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="启动" FontWeight="Bold" FontSize="14" />
                <CheckBox Content="开机时自动启动 WordLens"
                          IsChecked="{Binding StartWithSystem}"
                          IsEnabled="{Binding IsStartupSupported}" />
                <TextBlock Text="当前系统不支持自动配置开机自启"
                           FontSize="12"
                           Opacity="0.6"
                           IsVisible="{Binding !IsStartupSupported}" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="本地 API" FontWeight="Bold" FontSize="14" />
                <CheckBox Content="启用本地自动化 API"
                          IsChecked="{Binding LocalApiEnabled}" />
                <StackPanel Spacing="8"
                            IsEnabled="{Binding LocalApiEnabled}"
                            Margin="24,4,0,0"
                            Opacity="{Binding LocalApiEnabled, Converter={x:Static conv:BoolToOpacityConverter.BoolToOpacityValueConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="监听端口" FontSize="13" />
                        <NumericUpDown Value="{Binding LocalApiPort}"
                                       Minimum="1024"
                                       Maximum="65535"
                                       Increment="1"
                                       Width="160"
                                       HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="访问 Token" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding LocalApiToken}"
                                     Width="260"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center" />
                            <Button Content="重置"
                                    Command="{Binding RegenerateLocalApiTokenCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="仅监听 127.0.0.1。外部调用需携带 Authorization: Bearer Token。"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="欧路生词本" FontWeight="Bold" FontSize="14" />
                <CheckBox Content="启用欧路词典生词本同步"
                          IsChecked="{Binding EudicEnabled}" />
                <StackPanel Spacing="10"
                            IsEnabled="{Binding EudicEnabled}"
                            Margin="24,4,0,0"
                            Opacity="{Binding EudicEnabled, Converter={x:Static conv:BoolToOpacityConverter.BoolToOpacityValueConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="OpenAPI Token" FontSize="13" />
                        <TextBox Text="{Binding EudicToken}"
                                 PasswordChar="*"
                                 Width="300"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="语言" FontSize="13" />
                            <ComboBox ItemsSource="{Binding AvailableEudicLanguages}"
                                      SelectedValue="{Binding EudicLanguage}"
                                      SelectedValueBinding="{Binding Code}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      Width="120" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="生词本 ID" FontSize="13" />
                            <TextBox Text="{Binding EudicCategoryId}"
                                     Width="140"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="星级" FontSize="13" />
                            <NumericUpDown Value="{Binding EudicStar}"
                                           Minimum="0"
                                           Maximum="5"
                                           Increment="1"
                                           Width="88" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Token 可在欧路 OpenAPI 授权页生成；默认生词本 ID 通常为 0。"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="翻译框位置" FontWeight="Bold" FontSize="14" />
                <ComboBox ItemsSource="{Binding AvailableTranslationPopupPositionModes}"
                          SelectedValue="{Binding TranslationPopupPositionMode}"
                          SelectedValueBinding="{Binding Mode}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          Width="220"
                          HorizontalAlignment="Left" />
                <TextBlock Text="跟随鼠标会在触发翻译时靠近当前鼠标位置；记住位置会使用上次关闭翻译框时的位置"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="快捷键" FontWeight="Bold" FontSize="14" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Text="{Binding HotkeyDisplay}"
                             IsReadOnly="True"
                             Width="200"
                             VerticalContentAlignment="Center" />
                    <Button Content="设置快捷键"
                            Command="{Binding StartCaptureHotkeyCommand}"
                            CommandParameter="text"
                            IsEnabled="{Binding !IsCapturingHotkey}"
                            MinWidth="100" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Text="{Binding OcrHotkeyDisplay}"
                             IsReadOnly="True"
                             Width="200"
                             VerticalContentAlignment="Center" />
                    <Button Content="设置OCR快捷键"
                            Command="{Binding StartCaptureHotkeyCommand}"
                            CommandParameter="ocr"
                            IsEnabled="{Binding !IsCapturingHotkey}"
                            MinWidth="100" />
                </StackPanel>
                <TextBlock IsVisible="{Binding IsCapturingHotkey}"
                           Text="请按下想要设置的快捷键组合（按 ESC 取消）"
                           FontSize="12"
                           Foreground="Orange"
                           FontWeight="Bold" />
                <TextBlock IsVisible="{Binding !IsCapturingHotkey}"
                           Text="点击按钮后按下想要设置的快捷键组合"
                           FontSize="12"
                           Opacity="0.6" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="8">
                <TextBlock Text="流式输出" FontWeight="Bold" FontSize="14" />

                <CheckBox Content="启用流式输出（实时显示翻译结果）"
                          IsChecked="{Binding StreamingEnabled}"
                          ToolTip.Tip="启用后翻译内容将实时逐步显示，提供更好的用户体验" />

                <StackPanel Spacing="12"
                            IsEnabled="{Binding StreamingEnabled}"
                            Margin="24,8,0,0"
                            Opacity="{Binding StreamingEnabled, Converter={x:Static conv:BoolToOpacityConverter.BoolToOpacityValueConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="打字机效果延迟（毫秒）" FontSize="13" />
                        <NumericUpDown Value="{Binding TypewriterDelayMs}"
                                       Minimum="0"
                                       Maximum="200"
                                       Increment="10"
                                       Width="200"
                                       HorizontalAlignment="Left"
                                       ToolTip.Tip="每个字符显示之间的延迟时间" />
                        <TextBlock Text="0 = 无延迟，实时显示；推荐值：30-50毫秒"
                                   FontSize="11"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="每次显示字符数" FontSize="13" />
                        <NumericUpDown Value="{Binding CharsPerUpdate}"
                                       Minimum="1"
                                       Maximum="10"
                                       Increment="1"
                                       Width="200"
                                       HorizontalAlignment="Left"
                                       ToolTip.Tip="一次性显示的字符数量" />
                        <TextBlock Text="1 = 逐字显示；较大值可加快显示速度"
                                   FontSize="11"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="提示：流式输出可以让翻译过程更加流畅，但如果网络不稳定可以关闭此功能"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
