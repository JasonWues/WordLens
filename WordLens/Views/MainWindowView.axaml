<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordLens.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
        x:Class="WordLens.Views.MainWindowView"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{DynamicResource App_SettingsTitle}"
        Width="700" Height="550"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Margin="0">
        <!-- 主内容区域 -->
        <DrawerPage Grid.Row="0"
                    IsOpen="True"
                    DrawerBehavior="Locked"
                    DrawerLayoutBehavior="Split"
                    DrawerLength="220"
                    CompactDrawerLength="56">
            <DrawerPage.Drawer>
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="16"
                        x:DataType="vm:SettingsViewModel"
                        DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SettingsViewModel}">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,4,0,20">
                            <TextBlock Text="WordLens"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource Settings_Title}"
                                       FontSize="12"
                                       Opacity="0.65" />
                            <TextBlock Text="{Binding AutoSaveStatus}"
                                       FontSize="11"
                                       Opacity="0.55" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 SelectedIndex="{Binding SelectedSettingsSectionIndex}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBoxItem Content="{DynamicResource Settings_General}" />
                            <ListBoxItem Content="{DynamicResource Settings_TranslationProviders}" />
                            <ListBoxItem Content="OCR" />
                            <ListBoxItem Content="TTS" />
                            <ListBoxItem Content="{DynamicResource Settings_NetworkProxy}" />
                            <ListBoxItem Content="{DynamicResource Settings_History}" />
                            <ListBoxItem Content="{DynamicResource Settings_About}" />
                        </ListBox>
                    </Grid>
                </Border>
            </DrawerPage.Drawer>

            <DrawerPage.Content>
                <TransitioningContentControl Margin="10"
                                             x:DataType="vm:SettingsViewModel"
                                             DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SettingsViewModel}"
                                             Content="{Binding CurrentSectionViewModel}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.18" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </DrawerPage.Content>
        </DrawerPage>
    </Grid>
</Window>
