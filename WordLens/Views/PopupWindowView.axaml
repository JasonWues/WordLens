<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordLens.ViewModels"
        xmlns:models="using:WordLens.Models"
        x:Class="WordLens.Views.PopupWindowView"
        x:DataType="vm:PopupWindowViewModel"
        Width="380" Height="520"
        MinWidth="340" MinHeight="440"
        CanResize="True"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="WordLens - 翻译">
    <Design.DataContext>
        <vm:PopupWindowViewModel />
    </Design.DataContext>

    <Border Background="#F6F8FB"
            BorderBrush="#DCE3EA"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            BoxShadow="0 16 36 0 #26000000">
        <Grid>
            <Grid RowDefinitions="36,Auto,8,40,8,40,4,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      Background="#FFFFFF"
                      PointerPressed="TitleBar_PointerPressed">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="6"
                                Background="#E7F4EF">
                            <PathIcon Width="13"
                                      Height="13"
                                      Foreground="#1F7A68"
                                      Data="{StaticResource translate_regular}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="WordLens"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="翻译"
                               Classes="popup-caption"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Classes="icon-button popup-icon"
                            Classes.topmost-active="{Binding IsTopmost}"
                            Command="{Binding ToggleTopmostCommand}"
                            ToolTip.Tip="置顶窗口"
                            Margin="0,4,2,4">
                        <PathIcon Width="13"
                                  Height="13"
                                  Data="{StaticResource pin_regular}" />
                    </Button>

                    <Button Grid.Column="3"
                            Classes="icon-button popup-icon close"
                            Click="Close_Click"
                            ToolTip.Tip="关闭"
                            Margin="0,4,8,4">
                        <PathIcon Width="11"
                                  Height="11"
                                  Data="{StaticResource dismiss_regular}" />
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Classes="popup-card source-card"
                        Margin="10,8,10,0">
                    <Grid RowDefinitions="32,92,38">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="Auto,*,Auto"
                              Margin="13,0,13,0">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <PathIcon Width="13"
                                          Height="13"
                                          Foreground="#1F7A68"
                                          Data="{StaticResource link_regular}" />
                                <TextBlock Text="原文"
                                           Classes="section-title" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding SourceCharacterCount, StringFormat='{}{0} 字符'}"
                                       Classes="popup-caption"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding SourceText}"
                                 Classes="transparent-editor source-editor"
                                 PlaceholderText="输入或粘贴要翻译的文本" />

                        <Grid Grid.Row="2"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
                              ColumnSpacing="7"
                              Margin="10,0"
                              VerticalAlignment="Center">
                            <Button Grid.Column="0"
                                    Classes="icon-button popup-icon"
                                    Command="{Binding SpeakSourceCommand}"
                                    IsEnabled="{Binding CanSpeakSource}"
                                    ToolTip.Tip="朗读原文">
                                <PathIcon Width="13"
                                          Height="13"
                                          Data="{StaticResource speaker_regular}" />
                            </Button>

                            <Button Grid.Column="1"
                                    Classes="icon-button popup-icon"
                                    Command="{Binding CopySourceCommand}"
                                    IsEnabled="{Binding CanCopySource}"
                                    ToolTip.Tip="复制原文">
                                <PathIcon Width="13"
                                          Height="13"
                                          Data="{StaticResource copy_regular}" />
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="icon-button popup-icon"
                                    Command="{Binding AddSourceToVocabularyCommand}"
                                    IsEnabled="{Binding CanAddSourceToVocabulary}"
                                    ToolTip.Tip="加入欧路生词本">
                                <PathIcon Width="13"
                                          Height="13"
                                          Data="{StaticResource star_regular}" />
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="icon-button popup-icon close"
                                    Command="{Binding ClearSourceCommand}"
                                    IsEnabled="{Binding CanCopySource}"
                                    ToolTip.Tip="清空">
                                <PathIcon Width="12"
                                          Height="12"
                                          Data="{StaticResource dismiss_regular}" />
                            </Button>

                            <TextBlock Grid.Column="4"
                                       Text="{Binding VocabularyStatus}"
                                       Classes="popup-caption"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Grid.Column="5"
                                    Classes="target-pill"
                                    MinWidth="66"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedTargetLanguage.DisplayName, FallbackValue=英语, TargetNullValue=英语}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="#172033"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Button Grid.Column="6"
                                    Classes="translate-button primary-translate"
                                    Command="{Binding TranslateCommand}"
                                    ToolTip.Tip="翻译">
                                <PathIcon Width="15"
                                          Height="15"
                                          Data="{StaticResource translate_regular}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Classes="popup-control-strip"
                        Margin="10,0">
                    <Grid ColumnDefinitions="*,40,*"
                          Margin="6,0">
                        <ComboBox Grid.Column="0"
                                  Classes="language-selector"
                                  ItemsSource="{Binding SourceLanguages}"
                                  SelectedItem="{Binding SelectedSourceLanguage}"
                                  SelectedValueBinding="{Binding Code}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:LanguageInfo"
                                              x:DataType="models:LanguageInfo">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Classes="icon-button swap-button"
                                Command="{Binding SwapLanguagesCommand}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip.Tip="交换语言">
                            <PathIcon Width="15"
                                      Height="15"
                                      Data="{StaticResource arrow_swap_regular}" />
                        </Button>

                        <ComboBox Grid.Column="2"
                                  Classes="language-selector"
                                  ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage}"
                                  SelectedValueBinding="{Binding Code}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:LanguageInfo"
                                              x:DataType="models:LanguageInfo">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Row="5"
                        Classes="popup-control-strip"
                        Margin="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8"
                          Margin="12,0"
                          VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="翻译源"
                                   Classes="strip-label" />

                        <ComboBox Grid.Column="1"
                                  Classes="provider-selector"
                                  ItemsSource="{Binding AvailableTranslationProviders}"
                                  SelectedItem="{Binding SelectedTranslationProvider}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:ProviderConfig"
                                              x:DataType="models:ProviderConfig">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Classes="icon-button provider-refresh"
                                Command="{Binding RetranslateWithSelectedProviderCommand}"
                                ToolTip.Tip="使用所选翻译源重新翻译">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource translate_regular}" />
                        </Button>
                    </Grid>
                </Border>

                <ProgressBar Grid.Row="6"
                             IsVisible="{Binding IsBusy}"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="16,1"
                             Foreground="#1F7A68" />

                <ScrollViewer Grid.Row="7"
                              Margin="10,0,10,10"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TranslationResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:TranslationResult"
                                          x:DataType="models:TranslationResult">
                                <Border Classes="result-card"
                                        Margin="0,0,0,10">
                                    <Grid RowDefinitions="36,Auto">
                                        <Border Grid.Row="0"
                                                Classes="result-header">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Margin="12,0,6,0">
                                                <PathIcon Grid.Column="0"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="0,0,8,0"
                                                          Foreground="#1F7A68"
                                                          Data="{StaticResource sparkles_regular}"
                                                          VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProviderName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#172033"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Button Grid.Column="2"
                                                        Classes="icon-button popup-icon close"
                                                        Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).RemoveTranslationCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="移除此翻译源">
                                                    <PathIcon Width="10"
                                                              Height="10"
                                                              Data="{StaticResource dismiss_regular}" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Classes="result-body"
                                                MinHeight="92">
                                            <Grid RowDefinitions="34,Auto">
                                                <Grid Grid.Row="0"
                                                      ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                                      ColumnSpacing="7"
                                                      Margin="10,0"
                                                      VerticalAlignment="Center">
                                                    <Button Grid.Column="0"
                                                            Classes="icon-button popup-icon"
                                                            Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).SpeakTranslationCommand}"
                                                            CommandParameter="{Binding Result}"
                                                            IsVisible="{Binding IsSuccess}"
                                                            ToolTip.Tip="朗读此翻译">
                                                        <PathIcon Width="13"
                                                                  Height="13"
                                                                  Data="{StaticResource speaker_regular}" />
                                                    </Button>

                                                    <Button Grid.Column="1"
                                                            Classes="icon-button popup-icon"
                                                            Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).CopyTranslationCommand}"
                                                            CommandParameter="{Binding Result}"
                                                            IsVisible="{Binding IsSuccess}"
                                                            ToolTip.Tip="复制此翻译">
                                                        <PathIcon Width="13"
                                                                  Height="13"
                                                                  Data="{StaticResource copy_regular}" />
                                                    </Button>

                                                    <Button Grid.Column="2"
                                                            Classes="icon-button popup-icon"
                                                            Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).UseTranslationAsSourceCommand}"
                                                            IsEnabled="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).CanUseTranslationAsSource}"
                                                            IsVisible="{Binding IsSuccess}"
                                                            ToolTip.Tip="将译文作为新原文">
                                                        <PathIcon Width="13"
                                                                  Height="13"
                                                                  Data="{StaticResource arrow_turn_up_regular}" />
                                                    </Button>

                                                    <Grid Grid.Column="4"
                                                          Width="62"
                                                          Height="22"
                                                          VerticalAlignment="Center">
                                                        <Border Classes="tiny-pill loading"
                                                                IsVisible="{Binding IsLoading}">
                                                            <TextBlock Text="翻译中"
                                                                       Classes="tiny-pill-text loading" />
                                                        </Border>

                                                        <Border Classes="tiny-pill success"
                                                                IsVisible="{Binding IsSuccess}">
                                                            <TextBlock Text="完成"
                                                                       Classes="tiny-pill-text success" />
                                                        </Border>

                                                        <Border Classes="tiny-pill error"
                                                                IsVisible="{Binding IsError}">
                                                            <TextBlock Text="失败"
                                                                       Classes="tiny-pill-text error" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                                <TextBox Grid.Row="1"
                                                         Text="{Binding Result}"
                                                         Classes="transparent-editor result-editor"
                                                         IsReadOnly="True"
                                                         IsVisible="{Binding HasVisibleResult}" />

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ErrorMessage}"
                                                           IsVisible="{Binding IsError}"
                                                           Margin="12,0,12,12"
                                                           FontSize="12"
                                                           Foreground="#B42318"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="ResizeGrip_PointerPressed"
                    ToolTip.Tip="拖拽调整窗口大小">
                <PathIcon Width="10"
                          Height="10"
                          Margin="0,0,4,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Foreground="#8B98A8"
                          Data="M3 9H9V7.8H5.05L9 3.85V2.15L3.85 7.3V3H3V9Z" />
            </Border>
        </Grid>
    </Border>
</Window>
