<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordLens.ViewModels"
        xmlns:models="using:WordLens.Models"
        x:Class="WordLens.Views.PopupWindowView"
        x:DataType="vm:PopupWindowViewModel"
        Width="380" Height="520"
        MinWidth="340" MinHeight="440"
        CanResize="True"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="{DynamicResource Popup_WindowTitle}">
    <Design.DataContext>
        <vm:PopupWindowViewModel />
    </Design.DataContext>

    <Border Background="#F6F8FB"
            BorderBrush="#DCE3EA"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            BoxShadow="0 16 36 0 #26000000">
        <Grid>
            <Grid RowDefinitions="36,Auto,8,40,4,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      Background="#FFFFFF"
                      PointerPressed="TitleBar_PointerPressed">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="6"
                                Background="#E7F4EF">
                            <PathIcon Width="13"
                                      Height="13"
                                      Foreground="#1F7A68"
                                      Data="{StaticResource translate_regular}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="WordLens"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Popup_Title}"
                               Classes="popup-caption"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Classes="icon-button popup-icon"
                            Classes.topmost-active="{Binding IsTopmost}"
                            Command="{Binding ToggleTopmostCommand}"
                            ToolTip.Tip="{DynamicResource Common_PinTopmost}"
                            Margin="0,4,2,4">
                        <PathIcon Width="13"
                                  Height="13"
                                  Data="{StaticResource pin_regular}" />
                    </Button>

                    <Button Grid.Column="3"
                            Classes="icon-button popup-icon close"
                            Click="Close_Click"
                            ToolTip.Tip="{DynamicResource Common_Close}"
                            Margin="0,4,8,4">
                        <PathIcon Width="11"
                                  Height="11"
                                  Data="{StaticResource dismiss_regular}" />
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Classes="popup-card source-card"
                        Margin="10,8,10,0">
                    <Grid RowDefinitions="32,Auto,38">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="Auto,*,Auto"
                              Margin="13,0,13,0">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <PathIcon Width="13"
                                          Height="13"
                                          Foreground="#1F7A68"
                                          Data="{StaticResource link_regular}" />
                                <TextBlock Text="{DynamicResource Popup_SourceSection}"
                                           Classes="section-title" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding SourceCharacterCountText}"
                                       Classes="popup-caption"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBox x:Name="SourceEditor"
                                 Grid.Row="1"
                                 Text="{Binding SourceText}"
                                 Classes="transparent-editor source-editor"
                                 PlaceholderText="{DynamicResource Popup_SourcePlaceholder}" />

                        <Grid Grid.Row="2"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                              ColumnSpacing="7"
                              Margin="10,0"
                              VerticalAlignment="Center">
                            <Panel Grid.Column="0">
                                <Button Classes="icon-button popup-icon"
                                        Command="{Binding SpeakSourceCommand}"
                                        IsEnabled="{Binding CanSpeakSource}"
                                        IsVisible="{Binding !IsSpeaking}"
                                        ToolTip.Tip="{DynamicResource Popup_SpeakSource}">
                                    <PathIcon Width="13"
                                              Height="13"
                                              Data="{StaticResource speaker_regular}" />
                                </Button>

                                <Button Classes="icon-button popup-icon"
                                        Command="{Binding StopSpeechCommand}"
                                        IsVisible="{Binding IsSpeaking}"
                                        ToolTip.Tip="{DynamicResource Popup_StopSpeech}">
                                    <PathIcon Width="13"
                                              Height="13"
                                              Data="{StaticResource stop_regular}" />
                                </Button>
                            </Panel>

                            <Button Grid.Column="1"
                                    Classes="icon-button popup-icon"
                                    Classes.copied="{Binding IsSourceCopied}"
                                    Command="{Binding CopySourceCommand}"
                                    IsEnabled="{Binding CanCopySource}"
                                    ToolTip.Tip="{DynamicResource Popup_CopySource}">
                                <Panel>
                                    <PathIcon Width="13"
                                              Height="13"
                                              IsVisible="{Binding !IsSourceCopied}"
                                              Data="{StaticResource copy_regular}" />
                                    <PathIcon Width="13"
                                              Height="13"
                                              IsVisible="{Binding IsSourceCopied}"
                                              Data="{StaticResource checkmark_regular}" />
                                </Panel>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="icon-button popup-icon"
                                    Command="{Binding AddSourceToVocabularyCommand}"
                                    IsEnabled="{Binding CanAddSourceToVocabulary}"
                                    ToolTip.Tip="{DynamicResource Popup_AddVocabulary}">
                                <PathIcon Width="13"
                                          Height="13"
                                          Data="{StaticResource star_regular}" />
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="icon-button popup-icon close"
                                    Command="{Binding ClearSourceCommand}"
                                    IsEnabled="{Binding CanCopySource}"
                                    ToolTip.Tip="{DynamicResource Popup_ClearSource}">
                                <PathIcon Width="12"
                                          Height="12"
                                          Data="{StaticResource dismiss_regular}" />
                            </Button>

                            <TextBlock Grid.Column="4"
                                       Text="{Binding VocabularyStatus}"
                                       Classes="popup-caption"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Panel Grid.Column="5">
                                <Button Classes="translate-button primary-translate"
                                        Command="{Binding TranslateCommand}"
                                        IsVisible="{Binding !IsTranslating}"
                                        ToolTip.Tip="{DynamicResource Popup_TranslateTooltip}">
                                    <PathIcon Width="15"
                                              Height="15"
                                              Data="{StaticResource translate_regular}" />
                                </Button>

                                <Button Classes="translate-button stop-translate"
                                        Command="{Binding StopTranslationCommand}"
                                        IsVisible="{Binding IsTranslating}"
                                        ToolTip.Tip="{DynamicResource Popup_StopTranslation}">
                                    <PathIcon Width="15"
                                              Height="15"
                                              Data="{StaticResource stop_regular}" />
                                </Button>
                            </Panel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Classes="popup-control-strip"
                        Margin="10,0">
                    <Grid ColumnDefinitions="*,Auto,*,Auto,1.15*,Auto"
                          ColumnSpacing="4"
                          Margin="8,0">
                        <ComboBox Grid.Column="0"
                                  Classes="language-selector"
                                  MinWidth="0"
                                  ItemsSource="{Binding SourceLanguages}"
                                  SelectedItem="{Binding SelectedSourceLanguage}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:LanguageInfo"
                                              x:DataType="models:LanguageInfo">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Classes="icon-button swap-button"
                                Command="{Binding SwapLanguagesCommand}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Popup_SwapLanguages}">
                            <PathIcon Width="15"
                                      Height="15"
                                      Data="{StaticResource arrow_swap_regular}" />
                        </Button>

                        <ComboBox Grid.Column="2"
                                  Classes="language-selector"
                                  MinWidth="0"
                                  ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:LanguageInfo"
                                              x:DataType="models:LanguageInfo">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Grid.Column="3"
                                Width="1"
                                Height="18"
                                Margin="3,0"
                                Background="#E0E7EF"
                                VerticalAlignment="Center" />

                        <ComboBox Grid.Column="4"
                                  Classes="provider-selector"
                                  MinWidth="64"
                                  ItemsSource="{Binding AvailableTranslationProviders}"
                                  SelectedItem="{Binding SelectedTranslationProvider}"
                                  ToolTip.Tip="{Binding SelectedTranslationProvider.Name}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="models:ProviderConfig"
                                              x:DataType="models:ProviderConfig">
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="5"
                                Classes="icon-button provider-refresh"
                                Command="{Binding RetranslateWithSelectedProviderCommand}"
                                ToolTip.Tip="{DynamicResource Popup_RetranslateWithProvider}">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource arrow_clockwise_regular}" />
                        </Button>
                    </Grid>
                </Border>

                <ProgressBar Grid.Row="4"
                             IsVisible="{Binding IsTranslating}"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="16,1"
                             Foreground="#1F7A68" />

                <Grid Grid.Row="5"
                      Margin="10,2,10,10">
                    <ScrollViewer x:Name="ResultsScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="ResultsScrollViewer_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding TranslationResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TranslationResult"
                                              x:DataType="models:TranslationResult">
                                    <Border Classes="result-card"
                                            Margin="0,0,0,10">
                                        <Grid RowDefinitions="36,Auto">
                                            <Border Grid.Row="0"
                                                    Classes="result-header">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                      Margin="12,0,6,0">
                                                    <PathIcon Grid.Column="0"
                                                              Width="14"
                                                              Height="14"
                                                              Margin="0,0,8,0"
                                                              Foreground="#1F7A68"
                                                              Data="{StaticResource sparkles_regular}"
                                                              VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ProviderName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#172033"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Button Grid.Column="2"
                                                            Classes="icon-button popup-icon"
                                                            Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).RefreshTranslationCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding !IsLoading}"
                                                            ToolTip.Tip="{DynamicResource Common_Retranslate}">
                                                        <PathIcon Width="12"
                                                                  Height="12"
                                                                  Data="{StaticResource arrow_clockwise_regular}" />
                                                    </Button>

                                                    <Button Grid.Column="3"
                                                            Classes="icon-button popup-icon close"
                                                            Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).RemoveTranslationCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{DynamicResource Popup_RemoveResult}">
                                                        <PathIcon Width="10"
                                                                  Height="10"
                                                                  Data="{StaticResource dismiss_regular}" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Classes="result-body"
                                                    MinHeight="56">
                                                <Grid RowDefinitions="30,Auto">
                                                    <Grid Grid.Row="0"
                                                          ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                                          ColumnSpacing="7"
                                                          Margin="10,0"
                                                          VerticalAlignment="Center">
                                                        <Panel Grid.Column="0"
                                                               IsVisible="{Binding IsSuccess}">
                                                            <Button Classes="icon-button popup-icon"
                                                                    Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).SpeakTranslationCommand}"
                                                                    CommandParameter="{Binding Result}"
                                                                    IsVisible="{Binding !$parent[Window].((vm:PopupWindowViewModel)DataContext).IsSpeaking}"
                                                                    ToolTip.Tip="{DynamicResource Popup_SpeakResult}">
                                                                <PathIcon Width="13"
                                                                          Height="13"
                                                                          Data="{StaticResource speaker_regular}" />
                                                            </Button>

                                                            <Button Classes="icon-button popup-icon"
                                                                    Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).StopSpeechCommand}"
                                                                    IsVisible="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).IsSpeaking}"
                                                                    ToolTip.Tip="{DynamicResource Popup_StopSpeech}">
                                                                <PathIcon Width="13"
                                                                          Height="13"
                                                                          Data="{StaticResource stop_regular}" />
                                                            </Button>
                                                        </Panel>

                                                        <Button Grid.Column="1"
                                                                Classes="icon-button popup-icon"
                                                                Classes.copied="{Binding IsCopied}"
                                                                Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).CopyTranslationCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsSuccess}"
                                                                ToolTip.Tip="{DynamicResource Popup_CopyResult}">
                                                            <Panel>
                                                                <PathIcon Width="13"
                                                                          Height="13"
                                                                          IsVisible="{Binding !IsCopied}"
                                                                          Data="{StaticResource copy_regular}" />
                                                                <PathIcon Width="13"
                                                                          Height="13"
                                                                          IsVisible="{Binding IsCopied}"
                                                                          Data="{StaticResource checkmark_regular}" />
                                                            </Panel>
                                                        </Button>

                                                        <Button Grid.Column="2"
                                                                Classes="icon-button popup-icon"
                                                                Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).UseTranslationAsSourceCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsSuccess}"
                                                                ToolTip.Tip="{DynamicResource Popup_UseResultAsSource}">
                                                            <PathIcon Width="13"
                                                                      Height="13"
                                                                      Data="{StaticResource arrow_turn_up_regular}" />
                                                        </Button>

                                                        <Grid Grid.Column="4"
                                                              Height="22"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center">
                                                            <Border Classes="tiny-pill loading"
                                                                    IsVisible="{Binding IsLoading}">
                                                                <TextBlock Text="{DynamicResource Popup_StatusLoading}"
                                                                           Classes="tiny-pill-text loading" />
                                                            </Border>

                                                            <Border Classes="tiny-pill success"
                                                                    IsVisible="{Binding IsSuccess}">
                                                                <TextBlock Text="{DynamicResource Popup_StatusDone}"
                                                                           Classes="tiny-pill-text success" />
                                                            </Border>

                                                            <Border Classes="tiny-pill error"
                                                                    IsVisible="{Binding IsError}">
                                                                <TextBlock Text="{DynamicResource Popup_StatusFailed}"
                                                                           Classes="tiny-pill-text error" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>

                                                    <TextBox Grid.Row="1"
                                                             Text="{Binding Result}"
                                                             Classes="transparent-editor result-editor"
                                                             IsReadOnly="True"
                                                             IsVisible="{Binding HasVisibleResult}" />

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding ErrorMessage}"
                                                               IsVisible="{Binding IsError}"
                                                               Margin="12,0,12,12"
                                                               FontSize="12"
                                                               Foreground="#B42318"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel IsVisible="{Binding ShowEmptyHint}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <PathIcon Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  Foreground="#B8C4D2"
                                  Data="{StaticResource sparkles_regular}" />
                        <TextBlock Text="{DynamicResource Popup_EmptyHint}"
                                   Classes="popup-caption"
                                   IsVisible="{Binding HasEnabledProviders}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Popup_EmptyNoProviders}"
                                   Classes="popup-caption"
                                   IsVisible="{Binding !HasEnabledProviders}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="ResizeGrip_PointerPressed"
                    ToolTip.Tip="{DynamicResource Popup_ResizeTip}">
                <PathIcon Width="10"
                          Height="10"
                          Margin="0,0,4,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Foreground="#8B98A8"
                          Data="M3 9H9V7.8H5.05L9 3.85V2.15L3.85 7.3V3H3V9Z" />
            </Border>
        </Grid>
    </Border>
</Window>
