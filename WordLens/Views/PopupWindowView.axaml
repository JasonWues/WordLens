<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordLens.ViewModels"
        xmlns:models="using:WordLens.Models"
        xmlns:conv="using:WordLens.Converter"
        x:Class="WordLens.Views.PopupWindowView"
        x:DataType="vm:PopupWindowViewModel"
        Width="660" Height="560"
        MinWidth="460" MinHeight="360"
        CanResize="True"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="WordLens - 翻译">
    <Design.DataContext>
        <vm:PopupWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <StyleInclude Source="/Assets/Icons.axaml" />

        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style Selector="Button.icon-button:pointerover">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <Style Selector="Button.icon-button:pressed">
            <Setter Property="Background" Value="#22000000" />
        </Style>

        <Style Selector="Button.icon-button:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="Button.icon-button.close:pointerover">
            <Setter Property="Background" Value="#E5484D" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.icon-button.topmost-active">
            <Setter Property="Background" Value="#1D7AF3" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.icon-button.topmost-active:pointerover">
            <Setter Property="Background" Value="#2C83F4" />
        </Style>

        <Style Selector="Button.primary-action">
            <Setter Property="Background" Value="#1F7A68" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.primary-action:pointerover">
            <Setter Property="Background" Value="#238874" />
        </Style>

        <Style Selector="Button.ghost-action">
            <Setter Property="Background" Value="#F3F6F8" />
            <Setter Property="BorderBrush" Value="#DDE4EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.ghost-action:pointerover">
            <Setter Property="Background" Value="#EAF0F4" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4E9EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="Border.translation-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E4E9EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style Selector="Border.translation-card.success">
            <Setter Property="BorderBrush" Value="#67A77C" />
        </Style>

        <Style Selector="Border.translation-card.error">
            <Setter Property="BorderBrush" Value="#E5484D" />
            <Setter Property="Background" Value="#FFF8F8" />
        </Style>

        <Style Selector="Border.translation-card.loading">
            <Setter Property="BorderBrush" Value="#4B9EDB" />
        </Style>

        <Style Selector="TextBox.editor">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Window.Styles>

    <Border Margin="10"
            Background="#F7F9FB"
            BorderBrush="#DCE3E9"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            BoxShadow="0 18 48 0 #26000000">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E4E9EE"
                    BorderThickness="0,0,0,1"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                      Height="48"
                      Margin="12,0,8,0">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                Background="#E8F3F0"
                                CornerRadius="7">
                            <PathIcon Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="#1F7A68"
                                      Data="{StaticResource translate_regular}" />
                        </Border>
                        <TextBlock Text="WordLens"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="icon-button"
                            Classes.topmost-active="{Binding IsTopmost}"
                            Command="{Binding ToggleTopmostCommand}"
                            ToolTip.Tip="置顶窗口">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource pin_regular}" />
                    </Button>

                    <Button Grid.Column="3"
                            Classes="icon-button"
                            Click="Minimize_Click"
                            ToolTip.Tip="最小化">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource subtract_regular}" />
                    </Button>

                    <Button Grid.Column="4"
                            Classes="icon-button close"
                            Click="Close_Click"
                            ToolTip.Tip="关闭">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource dismiss_regular}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,12,Auto,12,Auto,*,8,Auto,*"
                  Margin="16">
                <Border Grid.Row="0"
                        Classes="panel"
                        Padding="12">
                    <Grid ColumnDefinitions="*,Auto,*,Auto"
                          ColumnSpacing="10">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="源语言"
                                       FontSize="11"
                                       Foreground="#66727C"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding SourceLanguages}"
                                      SelectedItem="{Binding SelectedSourceLanguage}"
                                      SelectedValueBinding="{Binding Code}"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="120">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:LanguageInfo">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="icon-button"
                                Command="{Binding SwapLanguagesCommand}"
                                Margin="0,18,0,0"
                                ToolTip.Tip="交换语言">
                            <PathIcon Width="16"
                                      Height="16"
                                      Data="{StaticResource arrow_swap_regular}" />
                        </Button>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="目标语言"
                                       FontSize="11"
                                       Foreground="#66727C"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding TargetLanguages}"
                                      SelectedItem="{Binding SelectedTargetLanguage}"
                                      SelectedValueBinding="{Binding Code}"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="120">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:LanguageInfo">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Classes="primary-action"
                                Command="{Binding TranslateCommand}"
                                Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="16"
                                          Height="16"
                                          Data="{StaticResource translate_regular}"
                                          Foreground="White" />
                                <TextBlock Text="翻译"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="原文"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding SourceCharacterCount, StringFormat='({0} 字符)'}"
                               FontSize="11"
                               Foreground="#66727C"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Classes="ghost-action"
                            Command="{Binding ClearSourceCommand}"
                            IsEnabled="{Binding CanCopySource}"
                            ToolTip.Tip="清空原文和译文">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource dismiss_regular}" />
                            <TextBlock Text="清空" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Classes="icon-button"
                            IsEnabled="{Binding CanCopySource}"
                            Click="CopySource_Click"
                            ToolTip.Tip="复制原文">
                        <PathIcon Width="14"
                                  Height="14"
                                  Data="{StaticResource copy_regular}" />
                    </Button>
                </Grid>

                <Border Grid.Row="4"
                        Grid.RowSpan="2"
                        Classes="panel">
                    <TextBox Text="{Binding SourceText}"
                             Classes="editor"
                             PlaceholderText="在此输入要翻译的文本..."
                             MinHeight="108" />
                </Border>

                <ProgressBar Grid.Row="6"
                             IsVisible="{Binding IsBusy}"
                             IsIndeterminate="True"
                             Height="3"
                             Foreground="#1F7A68" />

                <Grid Grid.Row="7"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8"
                      Margin="0,6,0,8">
                    <TextBlock Grid.Column="0"
                               Text="翻译结果"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding TranslationResults.Count, StringFormat='({0} 个翻译源)'}"
                               FontSize="11"
                               Foreground="#66727C"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasTranslationResults}" />

                    <Button Grid.Column="2"
                            Classes="ghost-action"
                            Command="{Binding UseTranslationAsSourceCommand}"
                            IsEnabled="{Binding CanUseTranslationAsSource}"
                            ToolTip.Tip="将第一个成功译文放入原文框">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource arrow_turn_up_regular}" />
                            <TextBlock Text="译文转原文" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="8">
                    <ItemsControl ItemsSource="{Binding TranslationResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:TranslationResult">
                                <Border Classes="translation-card"
                                        Classes.success="{Binding IsSuccess}"
                                        Classes.error="{Binding IsError}"
                                        Classes.loading="{Binding IsLoading}">
                                    <Grid RowDefinitions="Auto,8,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ProviderName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        IsVisible="{Binding IsLoading}">
                                                <ProgressBar Width="48"
                                                             Height="3"
                                                             IsIndeterminate="True" />
                                                <TextBlock Text="翻译中"
                                                           FontSize="11"
                                                           Foreground="#4B8EBF"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="5"
                                                        IsVisible="{Binding IsSuccess}">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="#67A77C"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="成功"
                                                           FontSize="11"
                                                           Foreground="#4D8A62"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="5"
                                                        IsVisible="{Binding IsError}">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="#E5484D"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="失败"
                                                           FontSize="11"
                                                           Foreground="#C83D42"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Classes="icon-button"
                                                    Click="CopyTranslation_Click"
                                                    IsVisible="{Binding IsSuccess}"
                                                    Tag="{Binding Result}"
                                                    ToolTip.Tip="复制此翻译">
                                                <PathIcon Width="12"
                                                          Height="12"
                                                          Data="{StaticResource copy_regular}" />
                                            </Button>
                                        </Grid>

                                        <TextBox Grid.Row="2"
                                                 Text="{Binding Result}"
                                                 IsVisible="{Binding HasVisibleResult}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 BorderThickness="0"
                                                 Background="#F7FAFC"
                                                 CornerRadius="6"
                                                 Padding="10"
                                                 LineHeight="20"
                                                 FontSize="13" />

                                        <Border Grid.Row="2"
                                                Background="#FFF1F1"
                                                BorderBrush="#F2B8BA"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10"
                                                IsVisible="{Binding IsError}">
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#A83236"
                                                       FontSize="12"
                                                       FontStyle="Italic" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
