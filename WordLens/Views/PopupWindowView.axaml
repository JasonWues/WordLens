<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordLens.ViewModels"
        xmlns:models="using:WordLens.Models"
        x:Class="WordLens.Views.PopupWindowView"
        x:DataType="vm:PopupWindowViewModel"
        Width="265" Height="315"
        MinWidth="265" MinHeight="315"
        CanResize="True"
        Topmost="{Binding IsTopmost}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="WordLens - 翻译">
    <Design.DataContext>
        <vm:PopupWindowViewModel />
    </Design.DataContext>
    <Border Background="#F7F7F7"
            CornerRadius="7"
            ClipToBounds="True">
        <Grid>
            <Grid RowDefinitions="26,Auto,6,28,4,28,6,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto"
                      Background="#FBFBFB"
                      PointerPressed="TitleBar_PointerPressed">
                <Button Grid.Column="0"
                        Classes="topmost-button"
                        Classes.topmost-active="{Binding IsTopmost}"
                        Command="{Binding ToggleTopmostCommand}"
                        ToolTip.Tip="置顶窗口"
                        Margin="3,2,0,2">
                    <StackPanel Orientation="Horizontal"
                                Spacing="3"
                                VerticalAlignment="Center">
                        <PathIcon Width="12"
                                  Height="12"
                                  Data="{StaticResource pin_regular}" />
                        <TextBlock Text="置顶"
                                   FontSize="10"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Classes="icon-button compact close"
                        Click="Close_Click"
                        ToolTip.Tip="关闭"
                        Margin="0,2,2,0">
                    <PathIcon Width="11"
                              Height="11"
                              Data="{StaticResource dismiss_regular}" />
                </Button>
                </Grid>

                <Border Grid.Row="1"
                    Margin="4,0"
                    Background="#E8E8E8"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Grid RowDefinitions="61,28">
                    <TextBox Grid.Row="0"
                             Text="{Binding SourceText}"
                             Classes="transparent-editor source-editor"
                             PlaceholderText="" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
                          ColumnSpacing="4"
                          Margin="6,0"
                          VerticalAlignment="Center">
                        <Button Grid.Column="0"
                                Classes="icon-button compact"
                                Command="{Binding SpeakSourceCommand}"
                                IsEnabled="{Binding CanSpeakSource}"
                                ToolTip.Tip="朗读原文">
                            <PathIcon Width="12"
                                      Height="12"
                                      Data="{StaticResource speaker_regular}" />
                        </Button>

                        <Button Grid.Column="1"
                                Classes="icon-button compact"
                                Command="{Binding CopySourceCommand}"
                                ToolTip.Tip="复制原文">
                            <PathIcon Width="12"
                                      Height="12"
                                      Data="{StaticResource copy_regular}" />
                        </Button>

                        <PathIcon Grid.Column="2"
                                  Width="12"
                                  Height="12"
                                  Margin="4,0"
                                  Foreground="#171717"
                                  Data="{StaticResource link_regular}"
                                  VerticalAlignment="Center" />

                        <Button Grid.Column="3"
                                Classes="icon-button compact"
                                Command="{Binding ClearSourceCommand}"
                                IsEnabled="{Binding CanCopySource}"
                                ToolTip.Tip="清空">
                            <PathIcon Width="12"
                                      Height="12"
                                      Data="{StaticResource dismiss_regular}" />
                        </Button>

                        <Border Grid.Column="5"
                                Background="#FFFFFF"
                                BorderBrush="#9A83C8"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="19"
                                MinWidth="48"
                                Padding="7,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTargetLanguage.DisplayName, FallbackValue=英语, TargetNullValue=英语}"
                                       FontSize="10"
                                       Foreground="#1D1D1D"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Button Grid.Column="6"
                                Classes="translate-button"
                                Command="{Binding TranslateCommand}"
                                ToolTip.Tip="翻译">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource translate_regular}" />
                        </Button>
                    </Grid>
                </Grid>
                </Border>

                <Border Grid.Row="3"
                    Margin="4,0"
                    Background="#DCDCDC"
                    CornerRadius="5"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,*,34,*,Auto">
                    <ComboBox Grid.Column="0"
                              Classes="language-selector"
                              ItemsSource="{Binding SourceLanguages}"
                              SelectedItem="{Binding SelectedSourceLanguage}"
                              SelectedValueBinding="{Binding Code}"
                              Width="92"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:LanguageInfo"
                                          x:DataType="models:LanguageInfo">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2"
                            Classes="icon-button compact"
                            Command="{Binding SwapLanguagesCommand}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="交换语言">
                        <PathIcon Width="14"
                                  Height="14"
                                  Data="{StaticResource arrow_swap_regular}" />
                    </Button>

                    <ComboBox Grid.Column="4"
                              Classes="language-selector"
                              ItemsSource="{Binding TargetLanguages}"
                              SelectedItem="{Binding SelectedTargetLanguage}"
                              SelectedValueBinding="{Binding Code}"
                              Width="92"
                              HorizontalAlignment="Right">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:LanguageInfo"
                                          x:DataType="models:LanguageInfo">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                </Border>

                <Border Grid.Row="5"
                    Margin="4,0"
                    Background="#DCDCDC"
                    CornerRadius="5"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="4"
                      Margin="6,0"
                      VerticalAlignment="Center">
                    <ComboBox Grid.Column="0"
                              Classes="provider-selector"
                              ItemsSource="{Binding AvailableTranslationProviders}"
                              SelectedItem="{Binding SelectedTranslationProvider}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="models:ProviderConfig"
                                          x:DataType="models:ProviderConfig">
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="1"
                            Classes="translate-button"
                            Command="{Binding RetranslateWithSelectedProviderCommand}"
                            ToolTip.Tip="使用所选翻译源重新翻译">
                        <PathIcon Width="14"
                                  Height="14"
                                  Data="{StaticResource translate_regular}" />
                    </Button>
                </Grid>
                </Border>

                <ProgressBar Grid.Row="6"
                          IsVisible="{Binding IsBusy}"
                          IsIndeterminate="True"
                          Height="2"
                          Margin="4,2,4,0"
                          Foreground="#288B51" />

                <ScrollViewer Grid.Row="7"
                           Margin="4,0,4,4"
                           VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TranslationResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:TranslationResult"
                                      x:DataType="models:TranslationResult">
                            <Border Margin="0,0,0,6"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid RowDefinitions="24,Auto">
                                    <Border Grid.Row="0"
                                            Background="#DCDCDC">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <PathIcon Grid.Column="0"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="9,0,5,0"
                                                      Foreground="#17A34A"
                                                      Data="{StaticResource translate_regular}"
                                                      VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProviderName}"
                                                       FontSize="10"
                                                       Foreground="#111111"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Button Grid.Column="2"
                                                    Classes="icon-button compact close"
                                                    Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).RemoveTranslationCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="移除此翻译源"
                                                    Margin="0,2,2,0">
                                                <PathIcon Width="10"
                                                          Height="10"
                                                          Data="{StaticResource dismiss_regular}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Background="#E8E8E8"
                                            MinHeight="40">
                                        <Grid RowDefinitions="28,Auto">
                                            <Grid Grid.Row="0"
                                                  ColumnDefinitions="Auto,Auto,Auto,*"
                                                  ColumnSpacing="5"
                                                  Margin="6,0"
                                                  VerticalAlignment="Center">
                                                <Button Grid.Column="0"
                                                        Classes="icon-button compact"
                                                        Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).SpeakTranslationCommand}"
                                                        CommandParameter="{Binding Result}"
                                                        IsVisible="{Binding IsSuccess}"
                                                        ToolTip.Tip="朗读此翻译">
                                                    <PathIcon Width="12"
                                                              Height="12"
                                                              Data="{StaticResource speaker_regular}" />
                                                </Button>

                                                <Button Grid.Column="1"
                                                        Classes="icon-button compact"
                                                        Command="{Binding $parent[Window].((vm:PopupWindowViewModel)DataContext).CopyTranslationCommand}"
                                                        CommandParameter="{Binding Result}"
                                                        IsVisible="{Binding IsSuccess}"
                                                        ToolTip.Tip="复制此翻译">
                                                    <PathIcon Width="12"
                                                              Height="12"
                                                              Data="{StaticResource copy_regular}" />
                                                </Button>

                                                <PathIcon Grid.Column="2"
                                                          Width="12"
                                                          Height="12"
                                                          Margin="4,0"
                                                          Foreground="#171717"
                                                          Data="{StaticResource sparkles_regular}"
                                                          VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="5"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsLoading}">
                                                    <ProgressBar Width="34"
                                                                 Height="2"
                                                                 IsIndeterminate="True"
                                                                 Foreground="#288B51" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBox Grid.Row="1"
                                                     Text="{Binding Result}"
                                                     Classes="transparent-editor result-editor"
                                                     IsVisible="{Binding HasVisibleResult}" />

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ErrorMessage}"
                                                       IsVisible="{Binding IsError}"
                                                       Margin="9,0,9,8"
                                                       FontSize="11"
                                                       Foreground="#A83236"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Width="16"
                    Height="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    Cursor="BottomRightCorner"
                    PointerPressed="ResizeGrip_PointerPressed"
                    ToolTip.Tip="拖拽调整窗口大小">
                <PathIcon Width="9"
                          Height="9"
                          Margin="0,0,3,3"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Foreground="#8A8A8A"
                          Data="M3 9H9V7.8H5.05L9 3.85V2.15L3.85 7.3V3H3V9Z" />
            </Border>
        </Grid>
    </Border>
</Window>
