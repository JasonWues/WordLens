<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WordLens.ViewModels"
             xmlns:models="using:WordLens.Models"
             xmlns:conv="using:WordLens.Converter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="WordLens.Views.TranslationHistoryView"
             x:DataType="vm:TranslationHistoryViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox.history-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.history-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Border.history-card">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E6EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.history-card:pointerover">
            <Setter Property="BorderBrush" Value="#B8C6D9" />
        </Style>

        <Style Selector="Button.history-icon-button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.history-icon-button:pointerover">
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>

        <Style Selector="Button.history-icon-button.is-favorite PathIcon">
            <Setter Property="Foreground" Value="#D09100" />
        </Style>

        <Style Selector="Button.history-filter-button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.history-filter-button.is-active">
            <Setter Property="Background" Value="#FFF8E1" />
            <Setter Property="BorderBrush" Value="#E4B844" />
            <Setter Property="Foreground" Value="#7A5A00" />
        </Style>

        <Style Selector="Button.history-primary-button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.history-primary-button:pointerover">
            <Setter Property="Background" Value="#1D4ED8" />
        </Style>

        <Style Selector="Button.history-danger-button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#FFF1F2" />
            <Setter Property="BorderBrush" Value="#F1C2C7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#B4232A" />
        </Style>

        <Style Selector="TextBlock.history-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>

        <Style Selector="TextBlock.history-chip">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
    </UserControl.Styles>

    <Border Background="#F7F8FA"
            Padding="18">
        <Grid RowDefinitions="Auto,12,Auto,10,Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="22" Height="22"
                                  Data="{StaticResource history_regular}"
                                  Foreground="#2563EB"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="翻译历史"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCount, StringFormat='累计 {0} 条记录'}"
                               FontSize="12"
                               Foreground="#6B7280" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="history-icon-button"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="刷新">
                        <PathIcon Width="15" Height="15"
                                  Data="{StaticResource arrow_clockwise_regular}" />
                    </Button>

                    <Button Classes="history-filter-button"
                            Classes.is-active="{Binding IsShowingFavoritesOnly}"
                            Command="{Binding ToggleShowFavoritesCommand}"
                            ToolTip.Tip="收藏筛选">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14"
                                      Data="{StaticResource star_regular}" />
                            <TextBlock Text="{Binding IsShowingFavoritesOnly, Converter={x:Static conv:BoolToTextConverter.BoolToParameterTextConverter}, ConverterParameter='仅收藏|全部'}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="history-danger-button"
                            Command="{Binding ClearAllCommand}"
                            ToolTip.Tip="清空所有历史">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14"
                                      Data="{StaticResource delete_regular}" />
                            <TextBlock Text="清空"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid ColumnDefinitions="Auto,*,8,Auto">
                    <PathIcon Grid.Column="0"
                              Width="16" Height="16"
                              Data="{StaticResource search_regular}"
                              Foreground="#6B7280"
                              VerticalAlignment="Center"
                              Margin="2,0,8,0" />

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchKeyword}"
                             PlaceholderText="搜索原文或翻译结果"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center" />

                    <Button Grid.Column="3"
                            Classes="history-primary-button"
                            Command="{Binding SearchCommand}">
                        <TextBlock Text="搜索"
                                   FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="4"
                         IsVisible="{Binding IsBusy}"
                         IsIndeterminate="True"
                         Height="2"
                         Margin="0,0,0,8"
                         Foreground="#2563EB" />

            <Grid Grid.Row="5">
                <ListBox Classes="history-list"
                         ItemsSource="{Binding Histories}"
                         SelectedItem="{Binding SelectedHistory}"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:TranslationHistory"
                                      x:DataType="models:TranslationHistory">
                            <Border Classes="history-card">
                                <Grid RowDefinitions="Auto,10,Auto,10,Auto"
                                      ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="6">
                                        <TextBlock Text="{Binding SourceText}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="3"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="14"
                                                   LineHeight="20"
                                                   Foreground="#111827" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="history-label"
                                                       Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                            <TextBlock Classes="history-chip"
                                                       Text="{Binding SourceLanguage, StringFormat='{}{0} ->'}" />
                                            <TextBlock Classes="history-chip"
                                                       Text="{Binding TargetLanguage}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Margin="14,0,0,0">
                                        <Button Classes="history-icon-button favorite-button"
                                                Classes.is-favorite="{Binding IsFavorite}"
                                                Command="{Binding $parent[UserControl].((vm:TranslationHistoryViewModel)DataContext).ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="收藏">
                                            <PathIcon Width="14" Height="14"
                                                      Data="{StaticResource star_regular}" />
                                        </Button>

                                        <Button Classes="history-icon-button"
                                                Command="{Binding $parent[UserControl].((vm:TranslationHistoryViewModel)DataContext).DeleteHistoryCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="删除"
                                                Foreground="#B4232A">
                                            <PathIcon Width="14" Height="14"
                                                      Data="{StaticResource delete_regular}" />
                                        </Button>
                                    </StackPanel>

                                    <Border Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Height="1"
                                            Background="#EDF0F4" />

                                    <Grid Grid.Row="4"
                                          Grid.ColumnSpan="2"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="5">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="译文"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2563EB" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ProviderNames}"
                                                           FontSize="11"
                                                           Foreground="#9CA3AF"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Right" />
                                            </Grid>

                                            <TextBlock Text="{Binding ResultsJson, Converter={x:Static conv:TranslationResultSummaryConverter.Summary}}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13"
                                                       LineHeight="19"
                                                       Foreground="#374151" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Classes="history-primary-button"
                                                Command="{Binding $parent[UserControl].((vm:TranslationHistoryViewModel)DataContext).OpenTranslationCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Bottom"
                                                ToolTip.Tip="重新翻译">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Width="13" Height="13"
                                                          Data="{StaticResource translate_regular}"
                                                          Foreground="#FFFFFF" />
                                                <TextBlock Text="翻译"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border IsVisible="{Binding !Histories.Count}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <PathIcon Width="54" Height="54"
                                  Data="{StaticResource history_regular}"
                                  Foreground="#CBD5E1" />
                        <TextBlock Text="暂无翻译历史"
                                   FontSize="16"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="翻译完成后会显示在这里"
                                   FontSize="12"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
