<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WordLens.ViewModels"
        x:Class="WordLens.Views.OcrResultWindowView"
        x:DataType="vm:OcrResultViewModel"
        Width="920"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Title="WordLens - OCR">
    <Design.DataContext>
        <vm:OcrResultViewModel />
    </Design.DataContext>
    <Border Margin="10"
            Background="#F7F9FB"
            BorderBrush="#DCE3E9"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True"
            BoxShadow="0 18 48 0 #26000000">
        <Grid RowDefinitions="Auto,*,Auto">
            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E4E9EE"
                    BorderThickness="0,0,0,1"
                    PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                      Height="48"
                      Margin="12,0,8,0">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                Background="#E8F3F0"
                                CornerRadius="7">
                            <PathIcon Width="16"
                                      Height="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="#1F7A68"
                                      Data="{StaticResource translate_regular}" />
                        </Border>
                        <TextBlock Text="OCR 翻译"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ProgressBar Grid.Column="1"
                                 Width="160"
                                 Height="3"
                                 Margin="0,0,12,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsBusy}" />

                    <Button Grid.Column="2"
                            Classes="icon-button medium"
                            Click="Minimize_Click"
                            ToolTip.Tip="最小化">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource subtract_regular}" />
                    </Button>

                    <Button Grid.Column="3"
                            Classes="icon-button medium danger-close"
                            Click="Close_Click"
                            ToolTip.Tip="关闭">
                        <PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource dismiss_regular}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,4,*"
                  Margin="16"
                  MinHeight="280">
                <Border Grid.Column="0"
                        Classes="panel"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Screenshot}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               IsVisible="{Binding HasScreenshot}" />
                        <TextBlock Text="暂无截图"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#66727C"
                                   IsVisible="{Binding !HasScreenshot}" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="Transparent" />

                <Border Grid.Column="2"
                        Classes="panel">
                    <TextBox Classes="ocr-editor"
                             Text="{Binding RecognizedText}"
                             PlaceholderText="识别到的文字会显示在这里，也可以手动修正后再翻译"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch" />
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E4E9EE"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               Classes.status-error="{Binding HasError}"
                               VerticalAlignment="Center"
                               Foreground="#66727C"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="1"
                            Classes="secondary-action"
                            Command="{Binding ReRecognizeCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <PathIcon Width="15"
                                      Height="15"
                                      Data="{StaticResource arrow_turn_up_regular}" />
                            <TextBlock Text="重新识别" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Classes="primary-action"
                            Command="{Binding TranslateCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <PathIcon Width="15"
                                      Height="15"
                                      Data="{StaticResource translate_regular}" />
                            <TextBlock Text="翻译" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
