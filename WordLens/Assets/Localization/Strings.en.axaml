    <x:String x:Key="General_Restore_Running">Restoring backup...</x:String>
    <x:String x:Key="General_Restore_DoneFormat">Restore complete: {0} files. Pre-restore backup saved as {1}.</x:String>
    <x:String x:Key="General_Restore_FailedFormat">Restore failed: {0}</x:String>
    <x:String x:Key="General_Restore_OpenDialogTitle">Choose WordLens backup</x:String>
    <x:String x:Key="General_LocalApi_Title">Local API</x:String>
    <x:String x:Key="General_LocalApi_Enable">Enable local automation API</x:String>
