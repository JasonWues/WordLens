    <x:String x:Key="General_LocalApi_Token">Access token</x:String>
    <x:String x:Key="General_LocalApi_Description">Listens only on 127.0.0.1. External calls must include Authorization: Bearer Token.</x:String>
    <x:String x:Key="General_Eudic_Title">Eudic vocabulary</x:String>
    <x:String x:Key="General_Eudic_Enable">Sync to Eudic vocabulary book</x:String>
    <x:String x:Key="General_Eudic_Token">OpenAPI token</x:String>
    <x:String x:Key="General_Eudic_Language">Language</x:String>
    <x:String x:Key="General_Eudic_CategoryId">Book ID</x:String>
    <x:String x:Key="General_Eudic_Star">Star level</x:String>
    <x:String x:Key="General_Eudic_Description">Generate the token from the Eudic OpenAPI authorization page. The default book ID is usually 0.</x:String>
    <x:String x:Key="General_PopupPosition_Title">Translation window position</x:String>
    <x:String x:Key="General_PopupPosition_Description">Follow mouse places the window near the cursor. Remember position uses the last position when the window was closed.</x:String>
    <x:String x:Key="General_Hotkey_Title">Hotkeys</x:String>
    <x:String x:Key="General_Hotkey_SetTranslation">Set hotkey</x:String>
    <x:String x:Key="General_Hotkey_SetOcr">Set OCR hotkey</x:String>
    <x:String x:Key="General_Hotkey_CapturePlaceholder">Press a hotkey...</x:String>
    <x:String x:Key="General_Hotkey_CaptureHintActive">Press the hotkey combination to use. Press Esc to cancel.</x:String>
    <x:String x:Key="General_Hotkey_CaptureHintIdle">Click a button, then press the hotkey combination.</x:String>
    <x:String x:Key="General_Streaming_Title">Streaming output</x:String>
    <x:String x:Key="General_Streaming_Enable">Enable streaming output</x:String>
    <x:String x:Key="General_Streaming_EnableTooltip">Shows translation content progressively in real time.</x:String>
    <x:String x:Key="General_Streaming_Delay">Typewriter delay (ms)</x:String>
    <x:String x:Key="General_Streaming_DelayTooltip">Delay between displayed characters.</x:String>
    <x:String x:Key="General_Streaming_DelayDescription">0 = no delay. Recommended: 30-50 ms.</x:String>
    <x:String x:Key="General_Streaming_Chars">Characters per update</x:String>
    <x:String x:Key="General_Streaming_CharsTooltip">Number of characters displayed per update.</x:String>
    <x:String x:Key="General_Streaming_CharsDescription">1 = character by character. Higher values display faster.</x:String>
    <x:String x:Key="General_Streaming_Description">Streaming makes translation feel smoother. Disable it if the network is unstable.</x:String>
