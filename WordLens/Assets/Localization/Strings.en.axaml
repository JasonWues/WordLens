    <x:String x:Key="General_UILanguage_Title">Interface language</x:String>
    <x:String x:Key="General_UILanguage_Description">Choose the app interface language. Translation languages are selected in the translation window.</x:String>
    <x:String x:Key="General_Font_Title">Interface font</x:String>
    <x:String x:Key="General_Font_Placeholder">Enter font family</x:String>
    <x:String x:Key="General_Font_Description">Choose a system font or enter an installed font name. Leave empty to use the default font.</x:String>
    <x:String x:Key="General_DefaultFontFormat">Default font ({0})</x:String>
    <x:String x:Key="General_Startup_Title">Startup</x:String>
    <x:String x:Key="General_Startup_StartWithSystem">Start WordLens when the system starts</x:String>
    <x:String x:Key="General_Startup_Unsupported">This system does not support automatic startup configuration.</x:String>
    <x:String x:Key="General_Backup_Title">Data backup</x:String>
    <x:String x:Key="General_Backup_Create">Back up data</x:String>
    <x:String x:Key="General_Backup_Restore">Restore backup</x:String>
    <x:String x:Key="General_Backup_Description">Backups include settings, translation history, and screenshot cache. Restore overwrites current data and creates a pre-restore backup.</x:String>
    <x:String x:Key="General_Backup_ChooseDestination">Choose where to save the backup...</x:String>
    <x:String x:Key="General_Backup_Canceled">Backup canceled.</x:String>
    <x:String x:Key="General_Backup_Running">Creating backup...</x:String>
    <x:String x:Key="General_Backup_DoneFormat">Backup complete: {0} files, {1}.</x:String>
    <x:String x:Key="General_Backup_FailedFormat">Backup failed: {0}</x:String>
    <x:String x:Key="General_Backup_SaveDialogTitle">Save WordLens backup</x:String>
