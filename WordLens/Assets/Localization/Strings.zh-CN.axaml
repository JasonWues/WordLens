    <x:String x:Key="Ocr_StatusFailedFormat">识别失败：{0}</x:String>

    <x:String x:Key="History_Title">翻译历史</x:String>
    <x:String x:Key="History_TotalCountFormat">累计 {0} 条记录</x:String>
    <x:String x:Key="History_FilterFavorites">仅收藏</x:String>
