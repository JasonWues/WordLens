    <x:String x:Key="Common_Retranslate">再翻訳</x:String>
    <x:String x:Key="Common_Reset">リセット</x:String>

    <x:String x:Key="Tray_ClipboardStart">クリップボードを監視</x:String>
    <x:String x:Key="Tray_ClipboardStop">監視を停止</x:String>
    <x:String x:Key="Tray_Settings">設定</x:String>
    <x:String x:Key="Tray_Exit">終了</x:String>

    <x:String x:Key="Settings_Title">設定</x:String>
    <x:String x:Key="Settings_General">一般</x:String>
    <x:String x:Key="Settings_TranslationProviders">翻訳</x:String>
    <x:String x:Key="Settings_Ocr">OCR</x:String>
    <x:String x:Key="Settings_Tts">TTS</x:String>
    <x:String x:Key="Settings_NetworkProxy">ネットワーク</x:String>
    <x:String x:Key="Settings_History">履歴</x:String>
    <x:String x:Key="Settings_About">情報</x:String>
    <x:String x:Key="Settings_AutoSaved">保存済み</x:String>
    <x:String x:Key="Settings_PendingSave">保存待ち</x:String>
    <x:String x:Key="Settings_Saving">保存中...</x:String>
    <x:String x:Key="Settings_SaveFailed">保存に失敗しました</x:String>
    <x:String x:Key="Settings_LoadingRestoredSettings">復元した設定を読み込み中...</x:String>
    <x:String x:Key="Settings_Restored">復元済み</x:String>
    <x:String x:Key="Settings_RestoreLoadFailed">復元後の設定読み込みに失敗しました</x:String>

    <x:String x:Key="General_UILanguage_Title">表示言語</x:String>
    <x:String x:Key="General_UILanguage_Description">アプリの表示言語を選択します。翻訳言語は翻訳ウィンドウで選択します。</x:String>
    <x:String x:Key="General_Font_Title">表示フォント</x:String>
    <x:String x:Key="General_Font_Placeholder">フォント名を入力</x:String>
    <x:String x:Key="General_Font_Description">システムフォントを選択するか、インストール済みフォント名を入力します。空欄の場合は既定フォントを使用します。</x:String>
    <x:String x:Key="General_DefaultFontFormat">既定フォント ({0})</x:String>
    <x:String x:Key="General_Startup_Title">起動</x:String>
    <x:String x:Key="General_Startup_StartWithSystem">システム起動時に WordLens を起動</x:String>
    <x:String x:Key="General_Startup_Unsupported">このシステムでは自動起動設定に対応していません。</x:String>
    <x:String x:Key="General_Backup_Title">データバックアップ</x:String>
    <x:String x:Key="General_Backup_Create">バックアップ</x:String>
    <x:String x:Key="General_Backup_Restore">復元</x:String>
    <x:String x:Key="General_Backup_Description">バックアップには設定、翻訳履歴、スクリーンショットキャッシュが含まれます。復元すると現在のデータが上書きされ、復元前バックアップが作成されます。</x:String>
    <x:String x:Key="General_Backup_ChooseDestination">バックアップの保存先を選択してください...</x:String>
    <x:String x:Key="General_Backup_Canceled">バックアップをキャンセルしました。</x:String>
    <x:String x:Key="General_Backup_Running">バックアップを作成中...</x:String>
    <x:String x:Key="General_Backup_DoneFormat">バックアップ完了：{0} ファイル、{1}。</x:String>
    <x:String x:Key="General_Backup_FailedFormat">バックアップ失敗：{0}</x:String>
    <x:String x:Key="General_Backup_SaveDialogTitle">WordLens バックアップを保存</x:String>
    <x:String x:Key="General_Restore_ChooseSource">復元するバックアップファイルを選択してください...</x:String>
    <x:String x:Key="General_Restore_Canceled">復元をキャンセルしました。</x:String>
    <x:String x:Key="General_Restore_Running">復元中...</x:String>
    <x:String x:Key="General_Restore_DoneFormat">復元完了：{0} ファイル。復元前バックアップは {1} として保存されました。</x:String>
    <x:String x:Key="General_Restore_FailedFormat">復元失敗：{0}</x:String>
    <x:String x:Key="General_Restore_OpenDialogTitle">WordLens バックアップを選択</x:String>
    <x:String x:Key="General_LocalApi_Title">ローカル API</x:String>
    <x:String x:Key="General_LocalApi_Enable">ローカル自動化 API を有効化</x:String>
    <x:String x:Key="General_LocalApi_Port">待受ポート</x:String>
    <x:String x:Key="General_LocalApi_Token">アクセストークン</x:String>
    <x:String x:Key="General_LocalApi_Description">127.0.0.1 のみで待ち受けます。外部呼び出しには Authorization: Bearer Token が必要です。</x:String>
    <x:String x:Key="General_Eudic_Title">Eudic 単語帳</x:String>
    <x:String x:Key="General_Eudic_Enable">Eudic 単語帳同期を有効化</x:String>
    <x:String x:Key="General_Eudic_Token">OpenAPI トークン</x:String>
    <x:String x:Key="General_Eudic_Language">言語</x:String>
    <x:String x:Key="General_Eudic_CategoryId">単語帳 ID</x:String>
    <x:String x:Key="General_Eudic_Star">星レベル</x:String>
    <x:String x:Key="General_Eudic_Description">トークンは Eudic OpenAPI 認可ページで生成できます。既定の単語帳 ID は通常 0 です。</x:String>
    <x:String x:Key="General_PopupPosition_Title">翻訳ウィンドウ位置</x:String>
    <x:String x:Key="General_PopupPosition_Description">マウス追従はカーソル付近に表示します。位置を記憶すると前回閉じた位置を使用します。</x:String>
    <x:String x:Key="General_Hotkey_Title">ホットキー</x:String>
    <x:String x:Key="General_Hotkey_SetTranslation">ホットキー設定</x:String>
    <x:String x:Key="General_Hotkey_SetOcr">OCR ホットキー設定</x:String>
    <x:String x:Key="General_Hotkey_CapturePlaceholder">ホットキーを押してください...</x:String>
    <x:String x:Key="General_Hotkey_CaptureHintActive">使用するキー組み合わせを押してください。Esc でキャンセルします。</x:String>
    <x:String x:Key="General_Hotkey_CaptureHintIdle">ボタンをクリックしてからキー組み合わせを押してください。</x:String>
    <x:String x:Key="General_Streaming_Title">ストリーミング出力</x:String>
    <x:String x:Key="General_Streaming_Enable">ストリーミング出力を有効化</x:String>
    <x:String x:Key="General_Streaming_EnableTooltip">翻訳結果をリアルタイムで段階的に表示します。</x:String>
    <x:String x:Key="General_Streaming_Delay">タイプライター遅延 (ms)</x:String>
    <x:String x:Key="General_Streaming_DelayTooltip">文字表示間の遅延時間。</x:String>
    <x:String x:Key="General_Streaming_DelayDescription">0 = 遅延なし。推奨値：30-50 ms。</x:String>
    <x:String x:Key="General_Streaming_Chars">一度に表示する文字数</x:String>
    <x:String x:Key="General_Streaming_CharsTooltip">更新ごとに表示する文字数。</x:String>
    <x:String x:Key="General_Streaming_CharsDescription">1 = 一文字ずつ表示。大きい値ほど高速です。</x:String>
    <x:String x:Key="General_Streaming_Description">ストリーミングにより翻訳表示が滑らかになります。ネットワークが不安定な場合は無効にできます。</x:String>
    <x:String x:Key="General_Language_Chinese">简体中文</x:String>
    <x:String x:Key="General_Language_English">English</x:String>
    <x:String x:Key="General_Language_Japanese">日本語</x:String>
    <x:String x:Key="General_EudicLanguage_English">英語</x:String>
    <x:String x:Key="General_EudicLanguage_French">フランス語</x:String>
    <x:String x:Key="General_EudicLanguage_German">ドイツ語</x:String>
    <x:String x:Key="General_EudicLanguage_Spanish">スペイン語</x:String>
    <x:String x:Key="General_PopupPosition_FollowMouse">マウスに追従</x:String>
    <x:String x:Key="General_PopupPosition_RememberPosition">位置を記憶</x:String>

    <x:String x:Key="Popup_WindowTitle">WordLens - 翻訳</x:String>
    <x:String x:Key="Popup_Title">翻訳</x:String>
    <x:String x:Key="Popup_SourceSection">原文</x:String>
    <x:String x:Key="Popup_SourcePlaceholder">翻訳するテキストを入力または貼り付け</x:String>
    <x:String x:Key="Popup_CharacterCountFormat">{0} 文字</x:String>
    <x:String x:Key="Popup_SpeakSource">原文を読み上げ</x:String>
    <x:String x:Key="Popup_CopySource">原文をコピー</x:String>
    <x:String x:Key="Popup_AddVocabulary">Eudic 単語帳に追加</x:String>
    <x:String x:Key="Popup_AddVocabularyRunning">Eudic 単語帳に追加中...</x:String>
    <x:String x:Key="Popup_ClearSource">クリア</x:String>
    <x:String x:Key="Popup_SwapLanguages">言語を入れ替え</x:String>
    <x:String x:Key="Popup_ProviderLabel">翻訳元</x:String>
    <x:String x:Key="Popup_RetranslateWithProvider">選択した翻訳元で再翻訳</x:String>
    <x:String x:Key="Popup_RemoveResult">この翻訳元を削除</x:String>
    <x:String x:Key="Popup_SpeakResult">この翻訳を読み上げ</x:String>
    <x:String x:Key="Popup_CopyResult">この翻訳をコピー</x:String>
    <x:String x:Key="Popup_UseResultAsSource">翻訳を新しい原文として使用</x:String>
    <x:String x:Key="Popup_StatusLoading">翻訳中</x:String>
    <x:String x:Key="Popup_StatusDone">完了</x:String>
    <x:String x:Key="Popup_StatusFailed">失敗</x:String>
    <x:String x:Key="Popup_ResizeTip">ドラッグしてサイズ変更</x:String>

    <x:String x:Key="Ocr_WindowTitle">WordLens - OCR</x:String>
    <x:String x:Key="Ocr_Title">OCR 翻訳</x:String>
    <x:String x:Key="Ocr_NoScreenshot">スクリーンショットなし</x:String>
    <x:String x:Key="Ocr_EditorPlaceholder">認識した文字がここに表示されます。翻訳前に修正できます。</x:String>
    <x:String x:Key="Ocr_ReRecognize">再認識</x:String>
    <x:String x:Key="Ocr_StatusWaiting">認識待ち</x:String>
    <x:String x:Key="Ocr_StatusReady">認識準備完了</x:String>
    <x:String x:Key="Ocr_StatusRecognizing">認識中...</x:String>
    <x:String x:Key="Ocr_StatusDoneFormat">認識完了、{0} 文字</x:String>
    <x:String x:Key="Ocr_StatusNoText">文字を認識できませんでした</x:String>
    <x:String x:Key="Ocr_StatusFailedFormat">認識失敗：{0}</x:String>

    <x:String x:Key="History_Title">翻訳履歴</x:String>
    <x:String x:Key="History_TotalCountFormat">合計 {0} 件</x:String>
    <x:String x:Key="History_FilterFavorites">お気に入り</x:String>
    <x:String x:Key="History_FilterAll">すべて</x:String>
    <x:String x:Key="History_FavoriteFilterTip">お気に入りフィルター</x:String>
    <x:String x:Key="History_ClearAllTip">すべての履歴をクリア</x:String>
    <x:String x:Key="History_SearchPlaceholder">原文または翻訳結果を検索</x:String>
    <x:String x:Key="History_ResultLabel">訳文</x:String>
    <x:String x:Key="History_EmptyTitle">翻訳履歴はありません</x:String>
    <x:String x:Key="History_EmptyDescription">翻訳が完了するとここに表示されます。</x:String>
    <x:String x:Key="History_LoadMore">さらに読み込む</x:String>
