<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="App_SettingsTitle">WordLens - 設定</x:String>

    <x:String x:Key="Common_Close">閉じる</x:String>
    <x:String x:Key="Common_Minimize">最小化</x:String>
    <x:String x:Key="Common_PinTopmost">最前面に固定</x:String>
